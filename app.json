{
  "expo": {
    "name": "Calendar App",
    "slug": "calendar-app-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "scheme": "calendar-appmobile",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.bookchaowalit.calendar-appmobile"
    },
    "android": {
      "package": "com.bookchaowalit.calendarappmobile"
    },
    "plugins": [
      "expo-router"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
